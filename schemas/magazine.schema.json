{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Domain magazine contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "magazine_id",
    "version",
    "domain",
    "title",
    "applicability",
    "limitations",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "domain.magazine/1"
    },
    "magazine_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "applicability": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "topics",
          "scope",
          "purposes",
          "permission",
          "known_at",
          "known_at_basis",
          "embargo_oos",
          "supersedes",
          "required_context",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "FACT",
              "METHOD",
              "HYPOTHESIS",
              "EXPLORATORY",
              "CORRECTION",
              "DISSENT",
              "LIMITATION"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "purposes": {
            "type": "array",
            "items": {
              "enum": [
                "offline_audit",
                "historical_replay"
              ]
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "permission": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "known_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "known_at_basis": {
            "type": "string",
            "minLength": 1
          },
          "embargo_oos": {
            "enum": [
              "CLEAR",
              "EMBARGO",
              "UNKNOWN"
            ]
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "required_context": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact",
              "start_line",
              "end_line",
              "artifact_sha256",
              "excerpt_sha256"
            ],
            "properties": {
              "artifact": {
                "type": "string",
                "minLength": 1
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "excerpt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
